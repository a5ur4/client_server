# Configuração do Servidor ConectaShop.
# Copie este arquivo para ".env" e ajuste os valores.
# Comentários só em linha própria. Argumentos de iniciar.py e variáveis de
# ambiente já definidas têm prioridade sobre este arquivo.

# Código da nossa equipe (devolvido em server_team e gravado nos logs).
SERVER_TEAM=S01

# Interface de escuta. 0.0.0.0 aceita conexões de outras máquinas da rede.
SERVER_HOST=0.0.0.0

# Porta da API REST (REST_BASE_URL = http://IP_DA_MAQUINA:REST_PORT).
REST_PORT=8080

# Porta do ShippingService (GRPC_TARGET = IP_DA_MAQUINA:GRPC_PORT).
GRPC_PORT=50051

# Log de todas as chamadas recebidas (relativo à pasta do Servidor).
SERVER_LOG_FILE=logs/integracao_servidor.log

# Arquivo SQLite com o registro das chamadas, usado por consultar_logs.py.
SERVER_DB_FILE=dados/conectashop.db
