# Configuração do Cliente ConectaShop.
# Copie este arquivo para ".env" e ajuste os valores depois do sorteio.
# Comentários só em linha própria. Argumentos de linha de comando e variáveis
# de ambiente já definidas têm prioridade sobre este arquivo.

# Código da nossa equipe (enviado em X-Client-Team e na metadata x-client-team).
CLIENT_TEAM=C01

# Servidores REST sorteados. Mais de um: separe por vírgula.
REST_BASE_URL=http://10.0.0.23:8080,http://10.0.0.25:8080
# Código da equipe de cada Servidor REST, na mesma ordem.
REST_SERVER_TEAM=S03,S05

# Servidores gRPC sorteados, no formato host:porta. Mais de um: separe por vírgula.
GRPC_TARGET=10.0.0.24:50051,10.0.0.26:50051
# Código da equipe de cada Servidor gRPC, na mesma ordem (o Health confirma).
GRPC_SERVER_TEAM=S04,S06

# Tempo máximo de espera por chamada, em segundos.
CLIENT_TIMEOUT=5

# Arquivo de log das integrações (relativo à pasta do Cliente).
CLIENT_LOG_FILE=logs/integracao_cliente.log
